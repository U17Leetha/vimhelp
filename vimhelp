#!/bin/sh
# vimhelp - open a topic from Vim's built-in help straight from your shell.
#
# vimhelp-install-marker: U17Leetha/vimhelp
#
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 U17Leetha
#
# Requires only a POSIX shell and Vim (or Neovim) on PATH.

set -eu

PROG="vimhelp"
VERSION="1.0.0"

usage() {
    cat <<'EOF'
Usage: vimhelp [OPTIONS] [SUBJECT]

Open Vim's built-in help (:help) on SUBJECT.

Arguments:
  SUBJECT        A Vim help topic, e.g. 'tabs', 'quickref', 'undo.txt'.
                 Omit SUBJECT to open the help index.

Options:
  -h, --help     Show this help and exit.
  -v, --version  Show version and exit.

Examples:
  vimhelp tabs         Open :help tabs in Vim.
  vimhelp quickref     Open Vim's quick reference.
  vimhelp undo.txt     Open a specific help file.
EOF
}

need() {
    command -v "$1" >/dev/null 2>&1
}

opt="${1:-}"

case "$opt" in
    -h | --help)
        usage
        exit 0
        ;;
    -v | --version)
        printf '%s %s\n' "$PROG" "$VERSION"
        exit 0
        ;;
    -*)
        usage >&2
        printf '%s: unknown option: %s\n' "$PROG" "$opt" >&2
        exit 2
        ;;
esac

# Locate an installed Vim (prefer vim, fall back to nvim).
editor=""
for candidate in vim nvim; do
    if need "$candidate"; then
        editor="$candidate"
        break
    fi
done

if [ -z "$editor" ]; then
    printf '%s: neither %s nor %s was found in PATH.\n' \
        "$PROG" "vim" "nvim" >&2
    printf '%s: install Vim (https://www.vim.org) and try again.\n' "$PROG" >&2
    exit 127
fi

# Open the requested help topic; with no subject, open the help index.
if [ -z "$opt" ]; then
    exec "$editor" -c help
else
    exec "$editor" -c "help $opt"
fi
